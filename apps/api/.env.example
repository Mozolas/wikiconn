PORT=3001
REDIS_URL=redis://localhost:6380
CORS_ORIGIN=http://localhost:3000
WIKI_CACHE_TTL_SECONDS=3600
WIKI_SEARCH_CACHE_TTL_SECONDS=300
LOG_LEVEL=log

# Wikimedia asks automated clients to say who they are and how to reach whoever
# runs them; anonymous agents get throttled and eventually blocked. If you run
# your own instance, put your own project URL or email in here.
WIKI_USER_AGENT=WikiConn/1.0 (https://github.com/Mozolas/wikiconn)
