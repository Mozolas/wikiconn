PORT=3001
REDIS_URL=redis://localhost:6380
CORS_ORIGIN=http://localhost:3000

# Reverse proxy hops in front of the API. Rate limiting buckets by client IP,
# which Express only reads out of X-Forwarded-For once this says how far to
# trust it. 0 is right for `pnpm dev`, where nothing sits in front; a deployment
# behind one proxy wants 1. Setting it higher than the real hop count lets a
# caller forge the header and slip the limit.
TRUST_PROXY_HOPS=0
WIKI_SEARCH_CACHE_TTL_SECONDS=300
LOG_LEVEL=log

# Wikimedia asks automated clients to say who they are and how to reach whoever
# runs them; anonymous agents get throttled and eventually blocked. If you run
# your own instance, put your own project URL or email in here.
WIKI_USER_AGENT=WikiConn/1.0 (https://github.com/Mozolas/wikiconn)
