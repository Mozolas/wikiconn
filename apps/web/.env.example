NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Public origin of the deployment. Canonical URLs, the sitemap and the social
# card are resolved against it, so it must be absolute and match the domain
# the site is actually served from.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed to play from a second device on your network. Point the two URLs
# above at your machine's LAN address, set CORS_ORIGIN in apps/api/.env to
# match, and list the same host here so the dev server stops rejecting it.
# NEXT_DEV_ALLOWED_ORIGINS=192.168.1.20
