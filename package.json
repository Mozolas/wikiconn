{
  "name": "wikiconn",
  "private": true,
  "version": "0.0.0",
  "description": "Multiplayer Wikipedia racing game",
  "license": "MIT",
  "author": "Marek Mozola <marek@mozola.net>",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "turbo": "^2.9.14",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
